{
  "manifest_version": 3,
  "name": "LinkedIn Page Monitor",
  "version": "1.3.0",
 "description": "Helps agency and Company Page administrators monitor activity for LinkedIn employee advocacy programs."
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/toolbar-logo.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ]
}
